{
  "manifest_version": 3,
  "version": "1.0",
  "name": "Celestial Sea",
  "description": "Teal accent on a light interface with a dark titlebar.",
  "author": "Josh Ellithorpe",
  "homepage_url": "https://github.com/zquestz/celestial-gtk-theme",
  "browser_specific_settings": {
    "gecko": {
      "id": "celestial-sea@zquestz.github.io"
    }
  },
  "theme": {
    "colors": {
      "frame": "#1b2224",
      "tab_background_text": "#a4abaa",
      "tab_selected": "#2eb398",
      "tab_text": "#ffffff",
      "tab_line": "#2eb398",
      "tab_loading": "#2eb398",
      "toolbar": "#ffffff",
      "toolbar_text": "#273134",
      "toolbar_field": "rgba(48, 61, 65, 0.08)",
      "toolbar_field_text": "#303d41",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#303d41",
      "toolbar_field_highlight": "#2eb398",
      "toolbar_field_highlight_text": "#ffffff",
      "popup": "#ffffff",
      "popup_text": "#303d41",
      "popup_highlight": "#2eb398",
      "popup_highlight_text": "#ffffff",
      "button_background_active": "#2eb398",
      "ntp_background": "#f7f7f7",
      "ntp_text": "#273134"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
