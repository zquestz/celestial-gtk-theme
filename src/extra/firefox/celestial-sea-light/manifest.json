{
  "manifest_version": 3,
  "version": "1.0",
  "name": "Celestial Sea Light",
  "description": "Teal accent on a light interface.",
  "author": "Josh Ellithorpe",
  "homepage_url": "https://github.com/zquestz/celestial-gtk-theme",
  "browser_specific_settings": {
    "gecko": {
      "id": "celestial-sea-light@zquestz.github.io"
    }
  },
  "theme": {
    "colors": {
      "frame": "#f2f2f2",
      "tab_background_text": "#50585a",
      "tab_selected": "#2eb398",
      "tab_text": "#ffffff",
      "tab_line": "#2eb398",
      "tab_loading": "#2eb398",
      "toolbar": "#ffffff",
      "toolbar_text": "#273134",
      "toolbar_field": "rgba(48, 61, 65, 0.08)",
      "toolbar_field_text": "#303d41",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#303d41",
      "toolbar_field_highlight": "#2eb398",
      "toolbar_field_highlight_text": "#ffffff",
      "popup": "#ffffff",
      "popup_text": "#303d41",
      "popup_highlight": "#2eb398",
      "popup_highlight_text": "#ffffff",
      "icons": "#273134",
      "icons_attention": "#2eb398",
      "button_background_hover": "#ebebeb",
      "button_background_active": "#dbdbdb",
      "ntp_background": "#f7f7f7",
      "ntp_text": "#273134"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
